{
  "name": "sensor-interactive",
  "version": "2.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "tslint -c tslint.json 'src/**/*.{ts,tsx}'",
    "lint:fix": "tslint -c tslint.json --fix 'src/**/*.{ts,tsx}'",
    "webpack": "cross-env NODE_ENV=production webpack --mode production",
    "webpack:watch": "cross-env NODE_ENV=production webpack -w --mode production",
    "dev-webpack": "cross-env NODE_ENV=development webpack --mode development",
    "dev-webpack:watch": "cross-env NODE_ENV=development webpack -w --mode development",
    "build": "cross-env NODE_ENV=production webpack --mode production",
    "dev-build": "cross-env NODE_ENV=development webpack --mode development",
    "start": "cross-env NODE_ENV=development webpack serve --mode development --open",
    "start:secure": "cross-env NODE_ENV=development webpack serve  --server-type https --server-options-key ~/.localhost-ssl/localhost.key --server-options-cert ~/.localhost-ssl/localhost.crt --mode development --open",
    "start:self-signed": "cross-env NODE_ENV=development webpack serve --https --mode development --open",
    "deploy": "./build_and_deploy.sh",
    "cloudfront:invalidations": "s3cmd cfinvalinfo cf://E3V22UD5MXF4CR",
    "cloudfront:inval-root": "aws cloudfront create-invalidation --distribution-id E3V22UD5MXF4CR --paths /index.html",
    "test:full": "npm-run-all test test:cypress",
    "test:cypress": "cypress run --browser chrome --config video=false,defaultCommandTimeout=10000 --env testEnv=local",
    "test:cypress:ci": "cypress run --browser chrome --env testEnv=local,requireSnapshots=true --record",
    "test:cypress:smoke": "cypress run --browser chrome --spec 'cypress/integration/smoke/*' --config video=false,defaultCommandTimeout=10000 --env testEnv=local",
    "test:cypress:branch": "cypress run --browser chrome --spec 'cypress/integration/branch/**/*' --config video=false,defaultCommandTimeout=10000 --env testEnv=local",
    "test:cypress:updateSnaps": "cypress run --browser chrome --spec 'cypress/integration/**/*' --config video=false,defaultCommandTimeout=10000 --env testEnv=local --env updateSnapshots=true",
    "test:cypress:master": "cypress run --browser chrome --config video=false,defaultCommandTimeout=10000 --env testEnv=master",
    "test:production": "cypress open --config video=false --env testEnv=production,failOnSnapshotDiff=false",
    "test:staging": "cypress open --config video=false --env testEnv=staging,failOnSnapshotDiff=false",
    "test:branch": "cypress open --config video=false --env testEnv=branch,failOnSnapshotDiff=false",
    "test:local": "cypress open --config video=false --env testEnv=local,failOnSnapshotDiff=false",
    "test:jest": "jest",
    "test:jest:watch": "jest --watchAll"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/admin-sredsol/sensor-interactive.git"
  },
  "author": "Admin Sredsol",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/admin-sredsol/sensor-interactive/issues"
  },
  "homepage": "https://github.com/admin-sredsol/sensor-interactive#readme",
  "dependencies": {
    "@concord-consortium/lara-interactive-api": "^1.13.0",
    "@concord-consortium/sensor-connector-interface": "^0.2.0",
    "@vernier/godirect": "^1.7.1",
    "d3-format": "^1.4.5",
    "dygraphs": "^2.2.1",
    "iframe-phone": "^1.4.0",
    "jest-environment-jsdom": "^30.4.1",
    "jquery": "^3.7.1",
    "lodash": "^4.18.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-modal": "^3.16.3",
    "semver": "^7.8.5",
    "shutterbug": "^1.5.0",
    "text-encoding": "^0.7.0"
  },
  "devDependencies": {
    "@concord-consortium/slate-editor": "^0.13.0",
    "@simonsmith/cypress-image-snapshot": "^10.0.4",
    "@types/d3-format": "^1.4.2",
    "@types/dygraphs": "^1.1.13",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-modal": "^3.16.3",
    "@types/semver": "^7.7.1",
    "@types/web-bluetooth": "^0.0.21",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.4",
    "cypress": "^15.17.0",
    "cypress-commands": "^3.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^37.9.7",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "html-webpack-plugin": "^5.6.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.1",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.1",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5",
    "wait-on": "^4.0.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.5"
  }
}
